# proton-firesafe configuration; see proton-firesafe(1).
# This is sh(1): no spaces around the =, and quote values with spaces.

# Where to send the swap requests and reminders. Nothing is sent without it.
MAILTO="jabley@strandkip.nl"

# The From: header of the mail; the default is MAILTO. Subjects start
# [proton-firesafe@HOST] whatever this says.
#MAILFROM="Firesafe <jabley@strandkip.nl>"

# The command that sends mail; it reads the message from standard input.
#SENDMAIL="/opt/local/bin/msmtp -t"

#PROTON_DRIVE=/opt/local/bin/proton-drive

# Volume names of the rotating disks.
#DISKS="Firesafe-A Firesafe-B"

# What to take out: my-files, devices, photos, and revisions (every older
# version of every file, which can make a takeout much bigger).
#SECTIONS="my-files devices photos"

#TAKEOUT_EVERY_DAYS=7
#SWAP_AFTER_DAYS=28
#KEEP_TAKEOUTS=2
#REMIND_EVERY_DAYS=7

# Mail if a takeout is still running after this many hours; 0 for never.
#TAKEOUT_WARN_HOURS=24

# Set to 7 for a weekly "all is well" message.
#STATUS_EVERY_DAYS=0
